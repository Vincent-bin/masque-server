+
+fn message_header(iov: *mut libc::iovec, count: usize) -> libc::msghdr {
+    // SAFETY: msghdr contains only integers and raw pointers, for which zero
+    // is valid. Zeroing also initializes musl's private padding. The callers
+    // retain the populated iovec arrays and their buffers across the syscall.
+    let mut header: libc::msghdr = unsafe { std::mem::zeroed() };
+    header.msg_iov = iov;
+    header.msg_iovlen = count as _;
+    header
 }
 
